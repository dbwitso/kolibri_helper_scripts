[Unit]
Description=Back up the LSHE Kolibri database every night at 01:30 Lusaka time

[Timer]
# The time zone is given here, so the server's own clock setting doesn't
# matter (the centre server runs on another zone). 01:30 is after the school
# day and before the monthly report (02:00 on the 1st).
OnCalendar=*-*-* 01:30:00 Africa/Lusaka
# If the server was off at that time, back up as soon as it starts.
Persistent=true

[Install]
WantedBy=timers.target
